function [J, gradJ] = computeJN(U, P, C, alpha, beta)
    % Calcule la fonctionnelle J_N(U) et son gradient
    N = size(P, 1);
    L = size(C, 1);
    J = 0;
    gradJ = zeros(N, 1);
    
    for ell = 1:L
        % Sommets du triangle ell
        vertices  = P(C(ell, :), :);
        U_ell = U(C(ell, :));
        
        % Calcul des gradients des fonctions de base
        A = [vertices(2, :) - vertices(1, :); vertices(3, :) - vertices(1, :)];
        grad_tau = A \ [eye(2); -1 -1];
        
        % Calcul de S_ell
        S_ell = norm(sum(U_ell .* grad_tau, 1))^2;
        
        % Calcul de la mesure du triangle
        area = polyarea(vertices(:, 1), vertices(:, 2));
        
        % Mise à jour de J
        J = J + area * (alpha * sqrt(1 + S_ell) + beta * S_ell);
        
        % Mise à jour du gradient
        for k = 1:3
            i = C(ell, k);
            if ~ismember(i, D)  % Si le sommet n'est pas sur le bord
                gradJ(i) = gradJ(i) + area * (alpha * (grad_tau(k, :) * sum(U_ell .* grad_tau, 1)') / sqrt(1 + S_ell) + 2 * beta * (grad_tau(k, :) * sum(U_ell .* grad_tau, 1)'));
            end
        end
    end
end